# No environment variables are required for local development.

# Legal pages of this installation. Set these and layerling shows the links on
# the start page and in Settings; leave them unset and no links appear. The
# pages themselves are not part of the project - drop impressum.html and
# datenschutz.html into apps/web/public/, where .gitignore keeps them out of Git.
# NEXT_PUBLIC_IMPRINT_URL=/impressum.html
# NEXT_PUBLIC_PRIVACY_URL=/datenschutz.html
# Optional, if the links should not read "Impressum" and "Datenschutz":
# NEXT_PUBLIC_IMPRINT_LABEL=Legal notice
# NEXT_PUBLIC_PRIVACY_LABEL=Privacy

# Support link and reminder. Without any setting, the footer shows a link to the
# project's own support page and a small card now and then points at it.
# Set your own address to send people there instead:
# NEXT_PUBLIC_SPONSOR_URL=https://example.org/donate
# Optional, if the button should not read "Support the project":
# NEXT_PUBLIC_SPONSOR_LABEL=Buy me a coffee
# Or switch the reminder card and the built-in link off (an address of your
# own above still shows its link):
# NEXT_PUBLIC_SUPPORT_HINT=off

# Announcements from the project on the start page (announcements.json, read
# live from GitHub) can be switched off as well:
# NEXT_PUBLIC_ANNOUNCEMENTS=off
